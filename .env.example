# Where the EVITA backend is. Leave unset to use the local default.
VITE_API_URL=http://127.0.0.1:3100/api/v1

# Optional. A plant code, name or UUID to pre-select on step 1 of onboarding,
# so an engineer who always works one site does not pick it every time. Leave
# unset and the form starts on an empty enterprise dropdown.
# TODO(aws): the posting belongs in the Cognito token claims once sign-in is
# wired to them, and should not be a build-time setting at all.
VITE_EVITA_PLANT=JSR-01
