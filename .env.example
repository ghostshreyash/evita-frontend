# Where the EVITA backend is. Leave unset to use the local default.
VITE_API_URL=http://127.0.0.1:3100/api/v1

# The plant this build is posted to - its code, name or UUID.
# TODO(aws): this belongs in the Cognito token claims once sign-in is wired to
# them. Until then the tablet has nothing that says which site it is at.
VITE_EVITA_PLANT=JSR-01
